# ============================================================================
# ImmortalWrt H5000M 定制化配置
# ============================================================================
# 此文件在基础配置之后应用，用于扩展和自定义功能
# GitHub Actions 会根据 inputs 参数进一步覆盖相关配置
# 注意：QModem 相关配置由 workflow 动态控制，不在此处硬编码

# ============================================================================
# 基础系统包
# ============================================================================
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_yq=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_luci-app-ramfree=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_ucode-mod-digest=y
CONFIG_PACKAGE_luci-lib-cbi=y
CONFIG_PACKAGE_luci-cbi=y
CONFIG_PACKAGE_luci-compat=y

# ============================================================================
# IPv6 基础设施
# ============================================================================
# 上游 mt7987_mt7992.defconfig 默认开启了 IPV6 但保留了 IPv6 netfilter
# 链路（kmod-ip6tables / kmod-ipt-nat6 / libip6tc 等）未启用状态，本项目
# 同时启用 mwan3（v2.11.16 在 IPV6 模式会创建带 -p ipv6-icmp --icmpv6-type
# 133..137 的 mwan3_hook 链）和多个代理组件（Nikki / HomeProxy / MosDNS），
# 它们都在 IPv6 路由转发时调用 ip6tables / ip6tables-mod-nat。
# 同步补齐 IPv6 netfilter 内核 + 用户态栈以及 ip6tables 扩展，避免运行时
# "can't initialize iptables table`filter`': Table does not exist (do you need to insmod?)"
# 和 mwan3 IPv6 路径静默失败。
CONFIG_PACKAGE_kmod-nf-ipt6=y
CONFIG_PACKAGE_kmod-ip6tables=y
CONFIG_PACKAGE_kmod-ip6tables-extra=y
CONFIG_PACKAGE_kmod-ipt-nat6=y
CONFIG_PACKAGE_kmod-nf-nat6=y
CONFIG_PACKAGE_kmod-ip6-tunnel=y
CONFIG_PACKAGE_libip6tc=y
CONFIG_PACKAGE_ip6tables-mod-nat=y
CONFIG_PACKAGE_ip6tables-extra=y
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_ip6tables-zz-legacy=y

# ============================================================================
# LuCI 主题和优化
# ============================================================================
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ============================================================================
# 默认取消的包
# ============================================================================
# CONFIG_PACKAGE_luci-app-wrtbwmon is not set
# CONFIG_PACKAGE_luci-app-rclone is not set
# CONFIG_PACKAGE_rclone is not set
# CONFIG_PACKAGE_rclone-ng is not set
# CONFIG_PACKAGE_rclone-webui-react is not set


# ============================================================================
# 硬件加速
# ============================================================================
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
CONFIG_PACKAGE_luci-app-Airpifanctrl=y

# ============================================================================
# 编译优化
# ============================================================================
CONFIG_CCACHE=y
# CONFIG_DEVEL is not set   # 禁用开发包，减少编译时间和产物体积
# CONFIG_BUILD_LOG is not set  # 禁用每个包的详细编译日志，减少 I/O 开销
CONFIG_KERNEL_BUILD_USER="builder"
CONFIG_KERNEL_BUILD_DOMAIN="github.actions"

# ============================================================================
# 运行时优化
# ============================================================================
# CONFIG_PACKAGE_htop is not set  # 运行时监控工具，无需编译

# ============================================================================
# WPA3 支持
# ============================================================================
CONFIG_PACKAGE_wpad-openssl=y
